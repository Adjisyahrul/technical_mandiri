                <mxCell id="c241" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;Partial unique index&lt;/b&gt; – maks. 1 pinjaman aktif per user:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;CREATE UNIQUE INDEX uq_loan_aktif ON loans (user_id)&lt;br&gt;WHERE status IN (&#39;SUBMITTED&#39;,&#39;APPROVED&#39;,&#39;DISBURSED&#39;);&lt;/font&gt;" vertex="1">
